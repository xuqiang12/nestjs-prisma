datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==============================
// 枚举（⭐新增：让类型更清晰）
// ==============================
enum MenuType { // ⭐修改：替换原来的 Int type
  DIRECTORY
  PAGE
}

// ==============================
// 用户表
// ==============================
model User {
  id             Int        @id @default(autoincrement()) // 用户ID
  username       String     @unique // 用户名（唯一）
  email          String     @unique // 邮箱（唯一）
  phone          String     @unique // ⭐修改：手机号唯一（如果用于登录）
  password       String // 密码
  roles          UserRole[] 
  avatar         String? // ⭐修改：允许为空
  isSuperAdmin   Boolean    @default(false) // ⭐新增：超级管理员
  createdAt      DateTime   @default(now()) // 创建时间
  updatedAt      DateTime   @updatedAt // 更新时间
}

// ==============================
// 角色表
// ==============================
model Role {
  id          Int              @id @default(autoincrement()) // 角色ID
  name        String           @unique // 角色名：admin/common
  users       UserRole[] // 关联用户
  permissions RolePermission[] // ⭐修改：Permissions -> permissions（规范命名）
  menus       MenuRole[] // ⭐新增：直接控制菜单权限
}

// ==============================
// 权限表（按钮/操作权限）
// ==============================
model Permission {
  id          Int              @id @default(autoincrement()) // 权限ID
  code        String           @unique // 权限码：system:user:add
  name        String // 权限名称：新增用户
  roles       RolePermission[] // 关联角色
  menuButtons MenuButton[]
}

// ==============================
// 用户 ↔ 角色 关联表
// ==============================
model UserRole {
  userId Int // 用户ID
  roleId Int // 角色ID
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId]) // 联合主键
}

// ==============================
// 角色 ↔ 权限 关联表
// ==============================
model RolePermission {
  roleId       Int // 角色ID
  permissionId Int // 权限ID
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId]) // 联合主键
}

// ==============================
// ⭐新增：角色 ↔ 菜单（控制菜单显示）
// ==============================
model MenuRole {
  menuId Int
  roleId Int

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([menuId, roleId])
}

// ==============================
// 菜单/页面表
// ==============================
model Menu {
  id        Int        @id @default(autoincrement()) // 菜单ID
  parentId  Int? // ⭐修改：去掉 @default(0)，顶级用 null
  name      String // 菜单/页面名称：用户管理
  path      String? // 前端路由
  component String? // 前端组件路径
  icon      String? // 菜单图标
  sort      Int?       @default(0) // 排序
  type      MenuType   @default(PAGE) // ⭐修改：用 enum
  buttons   MenuButton[] // 页面按钮
  roles     MenuRole[] // ⭐新增：关联角色（控制菜单权限）
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ==============================
// 菜单按钮表（页面 ↔ 按钮）
// ==============================
model MenuButton {
  id           Int        @id @default(autoincrement()) // 按钮ID
  menuId       Int // 所属页面ID
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permissionId Int // 权限ID
  permission   Permission @relation(fields: [permissionId], references: [id])
  name         String? // 按钮名称
  sort         Int?       @default(0)

  @@unique([menuId, permissionId])
}


// ==============================
// 向量数据库表
// ==============================
model Document {
  id        String   @id @default(cuid())
  content   String   // 原始文本（必须有）
  metadata  Json?    // 附加信息（可选）例如：{  "source": "vue.md",  "page": 3,  "type": "doc"}

  embedding Unsupported("vector") //让 Prisma 知道这里是 pgvector 类型
  createdAt DateTime @default(now())

  @@map("documents")
}