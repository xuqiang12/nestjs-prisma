

# PostgreSQL 数据库信息
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DATABASE=blog_db

# Nest 本地运行
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# 本地 Docker/PostgreSQL 连接串。
# 如果要切换到本地库，去 prisma/schema.prisma 里取消 LOCAL_DATABASE_URL 那两行注释，并注释掉 Neon 那两行。
LOCAL_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?schema=public

# Neon 远程数据库连接串。
# NEON_DATABASE_URL：打开 Connection pooling 后复制的连接串，通常包含 -pooler，供应用运行使用。
# NEON_DIRECT_URL：关闭 Connection pooling 后复制的连接串，不包含 -pooler，供 Prisma migrate/generate 使用。
# 如果要切换到 Neon，去 prisma/schema.prisma 里取消 NEON_DATABASE_URL / NEON_DIRECT_URL 那两行注释，并注释掉本地那两行。
NEON_DATABASE_URL="postgresql://neondb_owner:npg_dBtlTNpXU62k@ep-square-river-aobv8gx7-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_DIRECT_URL="postgresql://neondb_owner:npg_dBtlTNpXU62k@ep-square-river-aobv8gx7.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"



# Nest
PORT=3000

# Security
JWT_ACCESS_SECRET=nestjsPrismaAccessSecret
JWT_REFRESH_SECRET=nestjsPrismaRefreshSecret

