datasource db {
  provider = "postgresql"

  // 使用本地 Docker/PostgreSQL 时，取消下面两行注释，并注释掉 Neon 的两行。
  // url       = env("LOCAL_DATABASE_URL")
  // directUrl = env("LOCAL_DATABASE_URL")

  // 使用 Neon 时，保留下面两行生效。
  // NEON_DATABASE_URL 使用带 -pooler 的连接池地址，供应用运行使用。
  // NEON_DIRECT_URL 使用不带 -pooler 的直连地址，供 Prisma migrate/generate 使用。
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==============================
// 枚举（⭐新增：让类型更清晰）
// ==============================
enum MenuType {
  MENU
  PAGE
}

// ==============================
// 用户表
// ==============================
model User {
  id              String           @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 用户ID
  username        String           @unique // 用户名（唯一）
  email           String           @unique // 邮箱（唯一）
  phone           String           @unique // ⭐修改：手机号唯一（如果用于登录）
  password        String // 密码
  roles           UserRole[]
  aiConversations AiConversation[] // AI 会话列表
  avatar          String? // ⭐修改：允许为空
  isSuperAdmin    Boolean          @default(false) // ⭐新增：超级管理员
  isDeleted       Boolean          @default(false) // 软删除标记
  deletedAt       DateTime? // 软删除时间
  createdAt       DateTime         @default(now()) // 创建时间
  updatedAt       DateTime         @updatedAt // 更新时间
}

// ==============================
// 角色表
// ==============================
model Role {
  id          String           @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 角色ID
  name        String           @unique // 角色名：admin/common
  users       UserRole[] // 关联用户
  permissions RolePermission[] // ⭐修改：Permissions -> permissions（规范命名）
  menus       MenuRole[] // ⭐新增：直接控制菜单权限
}

// ==============================
// 权限表（按钮/操作权限）
// ==============================
model Permission {
  id          String           @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 权限ID
  code        String           @unique // 权限码：system:user:add
  name        String // 权限名称：新增用户
  roles       RolePermission[] // 关联角色
  menuButtons MenuButton[]
}

// ==============================
// 用户 ↔ 角色 关联表
// ==============================
model UserRole {
  userId String @db.VarChar(32) // 用户ID
  roleId String @db.VarChar(32) // 角色ID
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId]) // 联合主键
}

// ==============================
// 角色 ↔ 权限 关联表
// ==============================
model RolePermission {
  roleId       String     @db.VarChar(32) // 角色ID
  permissionId String     @db.VarChar(32) // 权限ID
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId]) // 联合主键
}

// ==============================
// ⭐新增：角色 ↔ 菜单（控制菜单显示）
// ==============================
model MenuRole {
  menuId String @db.VarChar(32)
  roleId String @db.VarChar(32)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([menuId, roleId])
}

// ==============================
// 菜单/页面表
// ==============================
model Menu {
  id        String       @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 菜单ID
  parentId  String?      @db.VarChar(32) // ⭐修改：去掉 @default(0)，顶级用 null
  name      String // 菜单/页面名称：用户管理
  path      String? // 前端路由
  component String? // 前端组件路径
  icon      String? // 菜单图标
  sort      Int?         @default(0) // 排序
  type      MenuType     @default(MENU) // MENU=侧边栏菜单，PAGE=详情页
  buttons   MenuButton[] // 页面按钮
  roles     MenuRole[] // ⭐新增：关联角色（控制菜单权限）
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ==============================
// 菜单按钮表（页面 ↔ 按钮）
// ==============================
model MenuButton {
  id           String     @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 按钮ID
  menuId       String     @db.VarChar(32) // 所属页面ID
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permissionId String     @unique @db.VarChar(32) // 权限ID
  permission   Permission @relation(fields: [permissionId], references: [id])
  name         String? // 按钮名称
  sort         Int?       @default(0)

  @@unique([menuId, permissionId])
}

// ==============================
// 向量数据库表
// ==============================
model Document {
  id              String           @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  knowledgeBaseId String?          @db.VarChar(32)
  knowledgeBase   AiKnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  fileId          String?          @db.VarChar(32)
  file            AiKnowledgeFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chunkIndex      Int?             @default(0)
  tokenCount      Int?
  charStart       Int?
  charEnd         Int?
  status          Int              @default(1)
  content         String // 原始文本（必须有）
  metadata        Json? // 附加信息（可选）例如：{  "source": "vue.md",  "page": 3,  "type": "doc"}

  embedding Unsupported("vector") //让 Prisma 知道这里是 pgvector 类型
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([knowledgeBaseId, status])
  @@index([fileId, chunkIndex])
  @@map("documents")
}

// ==============================
// AI 知识库配置表
// ==============================
model AiKnowledgeBase {
  id                   String                 @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  code                 String                 @unique
  name                 String
  description          String?
  ragMode              String                 @default("generic")
  provider             String                 @default("siliconflow")
  apiKeyEncrypted      String?
  endpoint             String?
  embeddingModel       String?
  embeddingDimension   Int                    @default(1024)
  embeddingProfileCode String                 @default("siliconflow-default")
  embeddingApiKeyMode  String                 @default("env")
  embeddingApiKeyRef   String?                @default("SILICONFLOW_API_KEY")
  chunkSize            Int                    @default(500)
  chunkOverlap         Int                    @default(100)
  retrievalLimit       Int                    @default(5)
  similarityThreshold  Float                  @default(0.45)
  responseBufferMb     Int                    @default(8)
  batchSize            Int                    @default(10)
  status               Int                    @default(1)
  agents               AiKnowledgeBaseAgent[]
  files                AiKnowledgeFile[]
  documents            Document[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status, updatedAt])
}

// ==============================
// AI 知识库 ↔ 智能体关联表
// ==============================
model AiKnowledgeBaseAgent {
  id              String          @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  knowledgeBaseId String          @db.VarChar(32)
  knowledgeBase   AiKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  agentId         String          @db.VarChar(32)
  agent           AiAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([knowledgeBaseId, agentId])
  @@index([agentId])
}

// ==============================
// AI 知识库源文件表
// ==============================
model AiKnowledgeFile {
  id              String          @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  knowledgeBaseId String          @db.VarChar(32)
  knowledgeBase   AiKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  originalName    String
  storagePath     String
  mimeType        String?
  size            Int             @default(0)
  checksum        String?
  chunkCount      Int             @default(0)
  status          String          @default("pending")
  errorMessage    String?
  documents       Document[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([knowledgeBaseId, status])
}

// ==============================
// AI 会话表
// ==============================
model AiConversation {
  id        String      @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 会话ID
  userId    String      @db.VarChar(32) // 所属用户ID
  user      User        @relation(fields: [userId], references: [id])
  title     String // 会话标题
  mode      String      @default("chat") // 会话模式：chat / knowledge
  agentCode String? // 本会话使用的智能体编码
  messages  AiMessage[] // 会话消息
  isDeleted Boolean     @default(false) // 软删除标记
  deletedAt DateTime? // 软删除时间
  createdAt DateTime    @default(now()) // 创建时间
  updatedAt DateTime    @updatedAt // 更新时间

  @@index([userId, isDeleted, updatedAt])
}

// ==============================
// AI 会话消息表
// ==============================
model AiMessage {
  id             String         @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32) // 消息ID
  conversationId String         @db.VarChar(32) // 所属会话ID
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 消息角色：user / assistant
  content        String // 消息内容
  sources        Json? // 知识库问答引用来源
  agentCode      String? // 生成消息时使用的智能体编码
  promptId       String?        @db.VarChar(32) // 生成消息时使用的提示词ID
  workflowCode   String? // 生成消息时使用的工作流编码
  createdAt      DateTime       @default(now()) // 创建时间

  @@index([conversationId, createdAt])
}

// ==============================
// AI 提示词配置表
// ==============================
model AiPrompt {
  id        String    @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  code      String    @unique
  name      String
  scene     String
  content   String
  status    Int       @default(1)
  remark    String?
  agents    AiAgent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([scene, status])
}

// ==============================
// AI 敏感词配置表
// ==============================
model AiSensitiveWord {
  id          String   @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  word        String
  category    String
  action      String
  replaceWith String?
  scope       String
  status      Int      @default(1)
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([word, scope])
  @@index([scope, status])
}

// ==============================
// AI 智能体配置表
// ==============================
model AiAgent {
  id                   String                 @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  code                 String                 @unique
  name                 String
  description          String?
  avatar               String?
  welcomeMessage       String?
  recommendedQuestions Json?
  tags                 Json?
  promptId             String                 @db.VarChar(32)
  prompt               AiPrompt               @relation(fields: [promptId], references: [id])
  promptSyncEnabled    Boolean                @default(true)
  promptSnapshot       String?
  promptEnhancement    String?
  mode                 String                 @default("chat")
  model                String?
  temperature          Float?
  topP                 Float?
  knowledgeEnabled     Boolean                @default(false)
  knowledgeStrict      Boolean                @default(false)
  knowledgeTags        Json?
  knowledgeBases       AiKnowledgeBaseAgent[]
  toolCodes            Json?
  workflowCode         String?
  status               Int                    @default(1)
  remark               String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([mode, status])
  @@index([promptId])
}

// ==============================
// AI 工作流配置表
// ==============================
model AiWorkflow {
  id          String           @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  code        String           @unique
  name        String
  description String?
  status      Int              @default(1)
  version     Int              @default(1)
  remark      String?
  nodes       AiWorkflowNode[]
  edges       AiWorkflowEdge[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, updatedAt])
}

// ==============================
// AI 工作流节点表
// ==============================
model AiWorkflowNode {
  id         String     @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  workflowId String     @db.VarChar(32)
  workflow   AiWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeKey    String
  type       String
  name       String
  config     Json
  sortNo     Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([workflowId, nodeKey])
  @@index([workflowId, sortNo])
}

// ==============================
// AI 工作流边表
// ==============================
model AiWorkflowEdge {
  id          String     @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  workflowId  String     @db.VarChar(32)
  workflow    AiWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNodeKey String
  toNodeKey   String
  condition   Json?
  sortNo      Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workflowId, fromNodeKey, sortNo])
}

// ==============================
// AI 技能包配置表
// ==============================
model AiSkillPackage {
  id            String   @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  code          String   @unique
  name          String
  description   String?
  promptIds     Json?
  toolCodes     Json?
  workflowCode  String?
  agentDefaults Json?
  status        Int      @default(1)
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, updatedAt])
}

// ==============================
// AI 工作流执行记录表
// ==============================
model AiWorkflowRun {
  id             String              @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  conversationId String?             @db.VarChar(32)
  messageId      String?             @db.VarChar(32)
  agentCode      String
  workflowCode   String
  status         String
  input          Json
  output         Json?
  errorMessage   String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  steps          AiWorkflowRunStep[]

  @@index([agentCode, workflowCode, createdAt])
  @@index([conversationId, createdAt])
}

// ==============================
// AI 工作流节点执行记录表
// ==============================
model AiWorkflowRunStep {
  id           String        @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  runId        String        @db.VarChar(32)
  run          AiWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeKey      String
  nodeType     String
  status       String
  input        Json?
  output       Json?
  errorMessage String?
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([runId, createdAt])
}

// ==============================
// 首页配置表
// ==============================
model HomeDecoration {
  id         String          @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  name       String          @db.VarChar(100)
  scene      String          @db.VarChar(32)
  status     Int             @default(1)
  sortNo     Int             @default(0) @map("sort_no")
  remark     String?         @db.VarChar(255)
  components HomeComponent[]
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([scene, status, sortNo])
  @@map("home_decoration")
}

// ==============================
// 首页组件表
// ==============================
model HomeComponent {
  id           String         @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  decorationId String         @map("decoration_id") @db.VarChar(32)
  decoration   HomeDecoration @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  templateId   String         @map("template_id") @db.VarChar(32)
  templateName String?        @map("template_name") @db.VarChar(100)
  info         Json
  sortNo       Int            @default(0) @map("sort_no")
  status       Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([decorationId, status, sortNo])
  @@map("home_component")
}

// ==============================
// 小程序底部导航配置表
// ==============================
model MobileTabBarConfig {
  id        String   @id @default(dbgenerated("next_snowflake_id()")) @db.VarChar(32)
  name      String   @db.VarChar(100)
  config    Json
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mobile_tabbar_config")
}
