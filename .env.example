# POSTGRES
POSTGRES_USER=prisma
POSTGRES_PASSWORD=topsecret
POSTGRES_DB=blog

# Nest run locally
DB_HOST=localhost
# Nest run in docker, change host to database container name
# DB_HOST=postgres
DB_PORT=5432
DB_SCHEMA=blog

# 本地 Docker/PostgreSQL 连接串。
# 如果要切换到本地库，去 prisma/schema.prisma 里取消 LOCAL_DATABASE_URL 那两行注释，并注释掉 Neon 那两行。
LOCAL_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=${DB_SCHEMA}

# Neon 远程数据库连接串。
# NEON_DATABASE_URL：打开 Connection pooling 后复制的连接串，通常包含 -pooler，供应用运行使用。
# NEON_DIRECT_URL：关闭 Connection pooling 后复制的连接串，不包含 -pooler，供 Prisma migrate/generate 使用。
# 如果要切换到 Neon，去 prisma/schema.prisma 里取消 NEON_DATABASE_URL / NEON_DIRECT_URL 那两行注释，并注释掉本地那两行。
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"
NEON_DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"

# Nest
PORT=3000

# Security
JWT_ACCESS_SECRET=nestjsPrismaAccessSecret
JWT_REFRESH_SECRET=nestjsPrismaRefreshSecret

# AI
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-7B-instruct
