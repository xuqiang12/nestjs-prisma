datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // previewFeatures = []
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  phone     String
  password  String
  role      String
  avatar    String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

