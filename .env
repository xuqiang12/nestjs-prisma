# MySQL 数据库信息
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=blog_db

# Nest 本地运行
DB_HOST=localhost
DB_PORT=3306

# Prisma 数据库连接（MySQL 版）
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${DB_HOST}:${DB_PORT}/${MYSQL_DATABASE}
# DATABASE_URL=mysql://root:123456@localhost:3306/blog_db

# Nest
PORT=3000

# Security
JWT_ACCESS_SECRET=nestjsPrismaAccessSecret
JWT_REFRESH_SECRET=nestjsPrismaRefreshSecret

# Chat
CHAT_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/com